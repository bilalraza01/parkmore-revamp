{%- comment -%}
  Finder data for a product, as one string: label§audience§name§why
  (Liquid snippets cannot return values, so callers capture this and split on "§".)
    label     first finder need that lists this product (needs sorted by position, horse before dog), or blank
    audience  "For horses", "For dogs" or "For horses and dogs", from the AUDIENCE-* tags
    name      finder item's display name, or the product title
    why       finder item's one-line why, or blank
  Usage:
    {%- capture meta -%}{%- render 'pm-product-meta', product: product -%}{%- endcapture -%}
    {%- assign meta = meta | split: '§' -%}
{%- endcomment -%}
{%- liquid
  assign m_name = ''
  assign m_why = ''
  assign m_label = ''
  assign m_items = shop.metaobjects.finder_item.values
  for it in m_items
    assign it_p = it.product.value
    if it_p.id == product.id
      if m_name == blank
        assign m_name = it.name.value
        assign m_why = it.why.value
      endif
    endif
  endfor
  if m_name == blank
    assign m_name = product.title
  endif

  assign m_needs = shop.metaobjects.finder_need.values
  assign m_animals = 'horse,dog' | split: ','
  for a in m_animals
    if m_label != blank
      break
    endif
    for pos in (0..50)
      if m_label != blank
        break
      endif
      for nd in m_needs
        assign nd_animal = nd.animal.value | json | remove: '"' | remove: '[' | remove: ']' | downcase | strip
        assign nd_pos = nd.position.value | default: 0
        if nd_animal == a and nd_pos == pos and m_label == blank
          for it in nd.items.value
            assign it_p = it.product.value
            if it_p.id == product.id
              assign m_label = nd.label.value
              break
            endif
          endfor
        endif
      endfor
    endfor
  endfor

  assign m_tags = product.tags | join: ',' | upcase
  assign m_horse = false
  assign m_dog = false
  if m_tags contains 'AUDIENCE-HORSE'
    assign m_horse = true
  endif
  if m_tags contains 'AUDIENCE-DOG'
    assign m_dog = true
  endif
  if m_horse and m_dog
    assign m_aud = 'For horses and dogs'
  elsif m_dog
    assign m_aud = 'For dogs'
  elsif m_horse
    assign m_aud = 'For horses'
  else
    assign m_aud = ''
  endif
-%}
{{- m_label | strip -}}§{{- m_aud -}}§{{- m_name | strip -}}§{{- m_why | strip -}}
