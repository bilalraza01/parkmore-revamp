{%- comment -%}
  Parkmore head assets. Rendered once from layout/theme.liquid, right after Ignite's base.css,
  so pm-base.css can override Ignite's variables.
  pm-pages.css is also needed on the cart and policy pages, which have no pm- section to load it.
  Search results pages are kept out of search engines (noindex), the links on them are still followed.
{%- endcomment -%}
{{ 'pm-dmsans-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'pm-lora-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'pm-base.css' | asset_url | stylesheet_tag }}
{%- if request.page_type == 'cart' or request.page_type == 'policy' -%}
  {{ 'pm-pages.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if request.page_type == 'search' -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}
<script src="{{ 'pm-base.js' | asset_url }}" defer="defer"></script>
