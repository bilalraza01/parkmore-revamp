        },
        "collapsible_row_JGGTJF": {
          "type": "collapsible_row",
          "settings": {
            "row_open": false,
            "heading": "How do I start a return?",
            "icon": "truck",
            "image_width": 20,
            "row_heading_tag": "h3",
            "row_content": "<p>Please contact Parkmore <strong>before sending anything back</strong>.</p><p>Eligible non-supplement products, such as unopened washes or topical creams, may be returned within <strong>10 days of delivery</strong> if they are unused, unopened, and in their original packaging.</p><p><strong>Nutritional supplements and Magnetic Crowns are not eligible for return.</strong></p><p>Once a return is approved, we’ll provide the appropriate return instructions.</p>",
            "page": "",
