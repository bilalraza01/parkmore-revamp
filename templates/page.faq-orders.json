        "collapsible_row_wzzmgF": {
          "type": "collapsible_row",
          "settings": {
            "row_open": false,
            "heading": "How can I track my order?",
            "icon": "truck",
            "image_width": 20,
            "row_heading_tag": "h3",
            "row_content": "<p>Parkmore orders are shipped via <strong>UPS</strong>.</p><p>Once your order has shipped, you’ll receive an email with your <strong>UPS tracking number</strong> so you can follow the shipment through delivery.</p><p>If you don’t see the tracking email, check your spam or junk folder first. If it’s still missing, contact us and we’ll help locate your shipment.</p>",
            "page": "",
            "content_embed": "",
            "button_text_size": "t3",
            "button_label_1": "",
