        "collapsible_row_Afixyp": {
          "type": "collapsible_row",
          "settings": {
            "row_open": false,
            "heading": "Do you ship internationally?",
            "icon": "airplane",
            "image_width": 20,
            "row_heading_tag": "h3",
            "row_content": "<p><strong>International availability is expanding.</strong> Parkmore now has representation in <strong>Canada</strong>, and customers in <strong>Europe</strong> are served through our separate company in Ireland.</p><p>Shipping options and product availability may vary by country, so please <strong>contact us before ordering outside the United States</strong> and we’ll help determine the best way to get Parkmore products to you.</p>",
