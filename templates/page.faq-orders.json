        "collapsible_row_UPgR8m": {
          "type": "collapsible_row",
          "settings": {
            "row_open": true,
            "heading": "What payment methods do you accept?",
            "icon": "card",
            "image_width": 20,
            "row_heading_tag": "h3",
            "row_content": "<p>Parkmore accepts the secure payment options displayed at checkout, including major credit and debit cards. Available payment methods may vary depending on your location and device.</p>",
            "page": "",
            "content_embed": "",
            "button_text_size": "t3",
            "button_label_1": "",
