        "collapsible_row_atEQfc": {
          "type": "collapsible_row",
          "settings": {
            "row_open": false,
            "heading": "When will my order ship?",
            "icon": "airplane",
            "image_width": 20,
            "row_heading_tag": "h3",
            "row_content": "<p>Orders placed before <strong>12:00 PM Eastern Time</strong> usually ship the same business day.</p><p>Orders placed after noon will typically ship the next business day.</p><p>We work hard to get orders out quickly because itchy horses and scratchy dogs shouldn’t have to wait.</p>",
