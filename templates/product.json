g }}\n    </details>\n  {% endif %}\n\n  {% if product.metafields.custom.recipe != blank %}\n    <details>\n      <summary><strong>Fred's Recipe</strong></summary>\n      {{ product.metafields.custom.recipe | metafield_tag }}\n    </details>\n  {% endif %}\n\n</div>",
