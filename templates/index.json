    "pm_reviews": {
      "type": "pm-reviews",
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "row": "1",
            "animal": "horse",
            "stars": true,
            "quote": "“Our entire barn has been on the Parkmore vitamin for over a year now. Anyone that visits the farm comments on the dapples, shiny coats and overall health of the entire herd.”",
            "name": "Cathy",
            "detail": "Performance and breeding barn"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "row": "1",
            "animal": "dog",
            "stars": true,
            "quote": "“After one month of my boy being on Parkmore, his shedding was down by half!”",
            "name": "Vickie Weber",
            "detail": "Great Dane owner"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "row": "1",
            "animal": "horse",
            "stars": true,
            "quote": "“Recently found out this horse is 31 years young. He gets immune booster periodically through the year. He is sound and happy and a good weight for an old guy.”",
            "name": "Deanna Craychee",
            "detail": "GLF Immune Support"
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "row": "1",
            "animal": "horse",
            "stars": true,
            "quote": "“Fabulous products, see results in a short time. Highly recommend.”",
            "name": "Nea Stevens",
            "detail": "H.I. Gut Herbs"
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "row": "2",
            "animal": "horse",
            "stars": false,
            "quote": "“Since making those changes, he’s brighter, less tense, and his coat is becoming glossy again. I take a whole-horse approach, and nutrition is a huge part of that.”",
            "name": "CJ Schmenk",
            "detail": "Horse trainer"
          }
        },
        "review_6": {
          "type": "review",
          "settings": {
            "row": "2",
            "animal": "dog",
            "stars": false,
            "quote": "“I was very hesitant, as everything we had tried seemed to only make things worse.”",
            "name": "Vickie Weber",
            "detail": "Before Parkmore"
          }
        },
        "review_7": {
          "type": "review",
          "settings": {
            "row": "2",
            "animal": "horse",
            "stars": false,
            "quote": "“These products made it so much easier for me to consistently give him that extra level of care throughout his recovery.”",
