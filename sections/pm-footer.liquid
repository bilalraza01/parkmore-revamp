{%- comment -%}
  Parkmore footer (Mockup 3 footer): ink background, brand column with the logo, link columns and a
  text column, then a bottom bar with copyright, the footer menu, social icons and payment icons.
  Replaces Ignite's footer with the same content (blocks, menus, social links, payment icons).
  Ignite's footer loaded only its own CSS and accordion script, so nothing else is lost by disabling it.
{%- endcomment -%}
{{ 'pm-footer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign ss = section.settings
  assign year = 'now' | date: '%Y'
-%}

<footer class="pm pm-ft pm-dark">
  <div class="pm-wrap">
    {%- if section.blocks.size > 0 -%}
      <div class="pm-ft__top">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'brand' -%}
              <div class="pm-ft__brand" {{ block.shopify_attributes }}>
                {%- if bs.logo != blank -%}
                  <a class="pm-ft__logo" href="{{ routes.root_url }}">
                    {{ bs.logo | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '140px', loading: 'lazy', alt: shop.name }}
                  </a>
                {%- endif -%}
                {%- if bs.heading != blank -%}<h2 class="pm-ft__h">{{ bs.heading | escape }}</h2>{%- endif -%}
                {%- if bs.text != blank -%}<div class="pm-ft__text">{{ bs.text }}</div>{%- endif -%}
              </div>
            {%- when 'menu' -%}
              {%- if bs.menu != blank -%}
                <nav class="pm-ft__col" aria-label="{{ bs.heading | default: bs.menu.title | escape }}" {{ block.shopify_attributes }}>
                  {%- if bs.heading != blank -%}<h2 class="pm-ft__h">{{ bs.heading | escape }}</h2>{%- endif -%}
                  <ul role="list">
                    {%- for link in bs.menu.links -%}
                      <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </nav>
              {%- endif -%}
            {%- when 'text' -%}
              <div class="pm-ft__col" {{ block.shopify_attributes }}>
                {%- if bs.heading != blank -%}<h2 class="pm-ft__h">{{ bs.heading | escape }}</h2>{%- endif -%}
                {%- if bs.text != blank -%}<div class="pm-ft__text">{{ bs.text }}</div>{%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="pm-ft__bottom">
      <div class="pm-ft__legal">
        {%- if ss.disclaimer != blank -%}<div class="pm-ft__disc">{{ ss.disclaimer }}</div>{%- endif -%}
        <p class="pm-ft__copy">
          <span>{{ 'sections.footer.copyright_html' | t: date: year, store_url: routes.root_url, store_name: shop.name }}</span>
          {%- if ss.show_powered_by %} <span>{{ powered_by_link }}</span>{%- endif -%}
        </p>
        {%- if ss.bottom_menu != blank and ss.bottom_menu.links.size > 0 -%}
          <ul class="pm-ft__mini" role="list">
            {%- for link in ss.bottom_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="pm-ft__side">
        {%- if shop.features.follow_on_shop? and ss.enable_follow_on_shop -%}
          <div class="pm-ft__follow">
            {% # theme-check-disable %}
            {{ shop | login_button: action: 'follow' }}
            {% # theme-check-enable %}
          </div>
        {%- endif -%}
        {%- if ss.show_social -%}{%- render 'social-icons', class: 'pm-ft__social' -%}{%- endif -%}
        {%- if ss.payment_enable and shop.enabled_payment_types.size > 0 -%}
          <div class="pm-ft__pay">
            <span class="pm-sr-only">{{ 'sections.footer.payment' | t }}</span>
            <ul role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "PM footer",
  "tag": "div",
  "class": "pm-section-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "link_list", "id": "bottom_menu", "label": "Bottom bar menu" },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true, "info": "Links are set in Theme settings > Social media." },
    { "type": "checkbox", "id": "payment_enable", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "enable_follow_on_shop", "label": "Show Follow on Shop", "default": true },
    { "type": "checkbox", "id": "show_powered_by", "label": "Show \"Powered by Shopify\"", "default": true },
    { "type": "richtext", "id": "disclaimer", "label": "Disclaimer", "info": "Optional small print above the copyright line, e.g. the FDA statement." }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [ { "name": "PM footer", "blocks": [ { "type": "brand" }, { "type": "menu" }, { "type": "menu" }, { "type": "text" } ] } ]
}
{% endschema %}
