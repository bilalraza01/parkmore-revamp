{%- comment -%}
  Parkmore "Owners also feed" (product page mockup option A): up to four other products from the
  product's audience collection (horses, dogs, or all products for the shared skin range).
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  capture meta
    render 'pm-product-meta', product: product
  endcapture
  assign meta = meta | split: '§'
  case meta[1]
    when 'For horses'
      assign coll = collections[ss.horse_collection]
      assign chap = ss.chap_horses
      assign word = ss.word_horses
    when 'For dogs'
      assign coll = collections[ss.dog_collection]
      assign chap = ss.chap_dogs
      assign word = ss.word_dogs
    else
      assign coll = collections[ss.all_collection]
      assign chap = ss.chap_all
      assign word = ''
  endcase
-%}
{%- if coll != blank and coll.products_count > 1 -%}
  {%- capture btn -%}{{ ss.button_label | replace: '[count]', coll.products_count | replace: '[animal]', word | replace: '  ', ' ' }}{%- endcapture -%}
  <section class="pm pm-psec pm-section pmp-more" aria-label="{{ chap | escape }}">
    <div class="pm-wrap">
      <div class="pm-shop-head">
        <div>{%- render 'pm-heading', chap_num: ss.chap_num, chap_label: chap, line: ss.heading, em: ss.heading_emphasis, em_break: false -%}</div>
        <a class="pm-btn pm-btn-line" href="{{ coll.url }}">{{ btn | strip }} <span class="pm-ar" aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="pm-grid4">
        {%- assign shown = 0 -%}
        {%- for p in coll.products -%}
          {%- if p.id != product.id and shown < 4 -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- capture pmeta -%}{%- render 'pm-product-meta', product: p -%}{%- endcapture -%}
            {%- assign pmeta = pmeta | split: '§' -%}
            {%- render 'pm-product-card', product: p, name: pmeta[2], use: pmeta[0], show_origin: false, reveal: shown -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PM owners also feed",
  "tag": "div",
  "class": "pm-section-pmore",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "chap_num", "label": "Chapter number", "default": "05" },
    { "type": "text", "id": "chap_horses", "label": "Chapter label (horse products)", "default": "More for horses" },
    { "type": "text", "id": "chap_dogs", "label": "Chapter label (dog products)", "default": "More for dogs" },
    { "type": "text", "id": "chap_all", "label": "Chapter label (horses and dogs)", "default": "More from Parkmore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Owners" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading gold ending", "default": "also feed." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "All [count] [animal] products", "info": "[count] and [animal] are filled in." },
    { "type": "text", "id": "word_horses", "label": "[animal] for horses", "default": "horse" },
    { "type": "text", "id": "word_dogs", "label": "[animal] for dogs", "default": "dog" },
    { "type": "text", "id": "horse_collection", "label": "Horse collection handle", "default": "horse-products" },
    { "type": "text", "id": "dog_collection", "label": "Dog collection handle", "default": "dog-products" },
    { "type": "text", "id": "all_collection", "label": "All products collection handle", "default": "all-products" }
  ],
  "presets": [ { "name": "PM owners also feed" } ]
}
{% endschema %}
