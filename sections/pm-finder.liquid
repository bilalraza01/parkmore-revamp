{%- comment -%}
  Parkmore formula finder (Mockup 3, section #finder).
  Step 1 horse/dog, step 2 need chips, result carousel ("Fleur recommends · 1 of 4").
  Data comes from metaobjects (Content > Metaobjects):
    finder_need: label, animal (horse/dog), position, items (list of finder_item)
    finder_item: admin_label, product, why, pair (optional product), name (optional display name)
  Only active entries are returned to the storefront. Other sections preselect an animal with data-pm-pick.
{%- endcomment -%}
{{ 'pm-finder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pm-finder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign ss = section.settings
  assign all_needs = shop.metaobjects.finder_need.values
  assign animals = 'horse,dog' | split: ','
-%}

{%- capture finder_json -%}
  {
  {%- for animal in animals -%}
    "{{ animal }}": {"needs": [
    {%- assign first_need = true -%}
    {%- for pos in (0..50) -%}
      {%- for need in all_needs -%}
        {%- liquid
          # Works whether Animal is a single choice or a one-item list
          assign need_animal = need.animal.value | json | remove: '"' | remove: '[' | remove: ']' | downcase | strip
          assign need_pos = need.position.value | default: 0
        -%}
        {%- if need_animal == animal and need_pos == pos -%}
          {%- unless first_need -%},{%- endunless -%}
          {%- assign first_need = false -%}
          {"label": {{ need.label.value | json }}, "products": [
          {%- assign first_item = true -%}
          {%- for item in need.items.value -%}
            {%- assign p = item.product.value -%}
            {%- if p != blank -%}
              {%- unless first_item -%},{%- endunless -%}
              {%- assign first_item = false -%}
              {%- liquid
                assign v = p.selected_or_first_available_variant
                assign display_name = item.name.value | default: p.title
                capture price
                  if p.price_varies
                    echo 'From '
                  endif
                  echo p.price_min | money_without_trailing_zeros
                endcapture
                assign pair = item.pair.value
              -%}
              {"name": {{ display_name | json }},
               "url": {{ p.url | json }},
               "img": {% if p.featured_image %}{{ p.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %},
               "price": {{ price | strip | json }},
               "why": {{ item.why.value | json }},
               "variant": {% if p.available %}{{ v.id }}{% else %}null{% endif %},
               "item": {{ item.admin_label.value | json }}
               {%- if pair != blank -%}, "also": {"name": {{ pair.title | json }}, "url": {{ pair.url | json }}}{%- endif -%}}
            {%- endif -%}
          {%- endfor -%}
          ]}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    ]}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  }
{%- endcapture -%}

<section class="pm pm-section pm-finder" id="{{ ss.anchor_id | default: 'finder' | handleize }}" aria-label="{{ ss.aria_label | escape }}" data-pm-finder>
  <div class="pm-wrap">
    <div class="pm-finder__head" data-pm-reveal>
      {%- render 'pm-heading', chap_num: ss.chap_num, chap_label: ss.chap_label, line: ss.heading, em: ss.heading_emphasis, em_break: true -%}
      {%- if ss.intro != blank -%}<p class="pm-lead">{{ ss.intro | escape }}</p>{%- endif -%}
    </div>

    <div class="pm-finder__card" data-pm-reveal="2">
      <div>
        <div class="pm-finder__step"><b>1</b>{{ ss.step_1 | escape }}</div>
        <div class="pm-finder__animals">
          <button class="pm-finder__animal" type="button" data-a="horse" aria-pressed="false">{%- render 'pm-icon', icon: 'horse' -%}{{ ss.horse_label | escape }}<small>{{ ss.horse_note | escape }}</small></button>
          <button class="pm-finder__animal" type="button" data-a="dog" aria-pressed="false">{%- render 'pm-icon', icon: 'dog' -%}{{ ss.dog_label | escape }}<small>{{ ss.dog_note | escape }}</small></button>
        </div>
        <div class="pm-finder__step"><b>2</b>{{ ss.step_2 | escape }}</div>
        <div class="pm-finder__needs" data-pm-needs><span class="pm-finder__hint">{{ ss.needs_hint | escape }}</span></div>
      </div>
      <div>
        <div class="pm-finder__rec" data-pm-rec>
          <button class="pm-finder__arr pm-finder__arr--prev" type="button" aria-label="Previous product" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
          <div class="pm-finder__result" data-pm-result role="region" aria-roledescription="carousel" aria-label="Recommended products" aria-live="polite" tabindex="-1">
            <div class="pm-finder__empty">
              <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="6.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M 63.8 97.6 C 65.9 97.9 72.2 98.9 76.2 99 C 80.2 99.2 84.1 99.3 87.6 98.6 C 91.1 97.9 94.5 96.7 97.1 94.8 C 99.8 92.9 102.1 90.3 103.8 87.2 C 105.5 84 107.1 79.9 107.6 75.7 C 108.2 71.6 108.1 66.1 107.1 62.4 C 106.2 58.8 104.2 57.5 101.9 53.9 C 99.6 50.2 95.5 44.5 93.3 40.5 C 91.2 36.6 90 34.8 89.1 30.1 C 88.1 25.3 87.9 15 87.6 12"/><path d="M 63.8 110.9 C 64.8 111.3 66.5 110.6 69.6 112.8 C 72.6 115.1 77 121.1 81.9 124.3 C 86.8 127.4 93 130.6 99 131.9 C 105.1 133.1 111.9 133 118.1 131.9 C 124.3 130.8 130.6 128.7 136.2 125.2 C 141.7 121.7 147.4 115.9 151.4 110.9 C 155.3 106 157.9 101 159.9 95.7 C 162 90.5 163.3 85.3 163.7 79.5 C 164.2 73.8 163.9 66.7 162.8 61.5 C 161.7 56.2 160.4 52.4 157.1 48.2 C 153.8 43.9 147.6 38.1 142.8 35.8 C 138.1 33.5 132.8 33.9 128.5 34.4 C 124.3 34.8 120.5 38.1 117.1 38.6 C 113.8 39.2 110.9 39.4 108.6 37.7 C 106.3 35.9 104.4 32.5 103.3 28.2 C 102.2 23.9 102.1 14.7 101.9 12"/><path d="M 63.8 97.6 A 27.6 27.6 0 0 0 63.8 152.8"/><path d="M 63.8 110.9 A 14.3 14.3 0 0 0 63.8 139.5"/><path d="M 63.8 139.5 L 141.9 139.5 A 20 20 0 0 1 141.9 179.4 L 78.1 179.4"/><path d="M 63.8 152.8 L 141.9 152.8 A 6.7 6.7 0 0 1 141.9 166.1 L 78.1 166.1"/><path d="M 78.1 166.1 C 66.7 166.1 60 172.8 60 184.2 L 60 188"/><path d="M 78.1 179.4 C 75.3 179.4 73.4 181.3 73.4 184.2 L 73.4 188"/></svg>
              <p>{{ ss.empty_text | escape }}</p>
            </div>
          </div>
          <button class="pm-finder__arr pm-finder__arr--next" type="button" aria-label="Next product" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </div>
        {%- if ss.vet_text != blank -%}
          <div class="pm-finder__vet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 2 18a2 2 0 0 0 1.7 3h16.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><div>{{ ss.vet_text }}</div></div>
        {%- endif -%}
      </div>
    </div>
  </div>
  <script type="application/json" data-pm-finder-data>{{ finder_json }}</script>
  <script type="application/json" data-pm-finder-text>{{ ss.recommends_label | json }}</script>
</section>

{% schema %}
{
  "name": "PM formula finder",
  "tag": "div",
  "class": "pm-section-finder",
  "settings": [
    { "type": "paragraph", "content": "Needs and products come from Content > Metaobjects > Finder need and Finder item." },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "finder" },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Find the right formula" },
    { "type": "text", "id": "chap_num", "label": "Chapter number", "default": "01" },
    { "type": "text", "id": "chap_label", "label": "Chapter label", "default": "Start here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us who you’re feeding." },
    { "type": "text", "id": "heading_emphasis", "label": "Heading gold ending (new line)", "default": "We’ll point you to the right formula." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Two taps, the same way Fleur would ask you at a show. If you’d rather talk it through, her team is a text away." },
    { "type": "header", "content": "Steps" },
    { "type": "text", "id": "step_1", "label": "Step 1 label", "default": "Who are we feeding?" },
    { "type": "text", "id": "horse_label", "label": "Horse card", "default": "Horse" },
    { "type": "text", "id": "horse_note", "label": "Horse card note", "default": "12 products" },
    { "type": "text", "id": "dog_label", "label": "Dog card", "default": "Dog" },
    { "type": "text", "id": "dog_note", "label": "Dog card note", "default": "3 products + skin care" },
    { "type": "text", "id": "step_2", "label": "Step 2 label", "default": "What’s going on?" },
    { "type": "text", "id": "needs_hint", "label": "Hint before choosing", "default": "Choose horse or dog first." },
    { "type": "text", "id": "empty_text", "label": "Empty result text", "default": "Your recommendation will appear here." },
    { "type": "text", "id": "recommends_label", "label": "Result label", "default": "Fleur recommends" },
    { "type": "richtext", "id": "vet_text", "label": "Vet warning", "default": "<p>Colic, choke, sudden lameness, or a horse or dog off food and water? <strong>Call your vet first.</strong> Parkmore products are nutritional support, not treatment.</p>" }
  ],
  "presets": [ { "name": "PM formula finder" } ]
}
{% endschema %}
