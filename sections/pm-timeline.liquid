{%- comment -%}
  Parkmore "Meet the people" timeline (Mockup 3, section #story).
  Four cards on a gold line that draws in. Each card uses its own image, or the chosen blog post's image.
{%- endcomment -%}
{{ 'pm-timeline.css' | asset_url | stylesheet_tag }}
{%- assign ss = section.settings -%}

<section class="pm pm-dark pm-section pm-story" id="{{ ss.anchor_id | default: 'story' | handleize }}" data-dark aria-label="{{ ss.aria_label | escape }}">
  <div class="pm-wrap">
    <div class="pm-story__head">
      <div data-pm-reveal>
        {%- render 'pm-heading', chap_num: ss.chap_num, chap_label: ss.chap_label, line: ss.heading, em: ss.heading_emphasis, em_break: true -%}
      </div>
      {%- if ss.intro != blank -%}<p data-pm-reveal="2">{{ ss.intro | escape }}</p>{%- endif -%}
    </div>

    <div class="pm-tl" data-pm-reveal-line>
      {%- for block in section.blocks -%}
        {%- liquid
          assign bs = block.settings
          assign img = bs.image
          if img == blank and bs.article != blank
            assign img = bs.article.image
          endif
          assign reveal = forloop.index | modulo: 4
          if reveal == 0
            assign reveal = 4
          endif
        -%}
        <article class="pm-tl__card" data-pm-reveal="{{ reveal }}" {{ block.shopify_attributes }}>
          {%- if bs.year != blank -%}<span class="pm-tl__yr">{{ bs.year | escape }}</span>{%- endif -%}
          <div class="pm-tl__ph">
            {%- if img != blank -%}
              {%- liquid
                # The card is 4:5 and crops with object-fit:cover. A wider image is shown wider than the card,
                # so scale the sizes hint by that factor or the browser picks a file that is too small.
                assign cover = img.aspect_ratio | divided_by: 0.8
                if cover < 1
                  assign cover = 1
                endif
                assign s_desk = 270 | times: cover | ceil
                assign s_tab = 45 | times: cover | ceil
                assign s_mob = 90 | times: cover | ceil
                capture img_sizes
                  echo '(min-width: 1101px) ' | append: s_desk | append: 'px, (min-width: 561px) ' | append: s_tab | append: 'vw, ' | append: s_mob | append: 'vw'
                endcapture
              -%}
              {{
                img
                | image_url: width: 2000
                | image_tag: widths: '300, 450, 600, 900, 1200, 1600, 2000', sizes: img_sizes, loading: 'lazy', alt: bs.image_alt, style: bs.image_position
              }}
            {%- else -%}
              <div class="pm-img-fallback">[{{ bs.image_alt | default: bs.title | escape }}: choose an image]</div>
            {%- endif -%}
          </div>
          <h3>{{ bs.title | escape }}</h3>
          <p>{{ bs.text | escape }}</p>
        </article>
      {%- endfor -%}
    </div>

    {%- if ss.button_1_label != blank or ss.button_2_label != blank -%}
      <div class="pm-story__more" data-pm-reveal>
        {%- if ss.button_1_label != blank -%}
          <a class="pm-btn pm-btn-gold" href="{{ ss.button_1_link | default: '#' }}">{{ ss.button_1_label | escape }} <span class="pm-ar" aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
        {%- if ss.button_2_label != blank -%}
          <a class="pm-btn pm-btn-line" href="{{ ss.button_2_link | default: '#' }}">{{ ss.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  /* Draw the gold line once the timeline scrolls into view */
  (function () {
    var tl = document.currentScript.previousElementSibling.querySelector('[data-pm-reveal-line]');
    if (!tl) return;
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) { tl.classList.add('in'); return; }
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { tl.classList.add('in'); io.disconnect(); } }); }, { threshold: 0.15 });
    io.observe(tl);
  })();
</script>

{% schema %}
{
  "name": "PM story timeline",
  "tag": "div",
  "class": "pm-section-story",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "story" },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Our story" },
    { "type": "text", "id": "chap_num", "label": "Chapter number", "default": "02" },
    { "type": "text", "id": "chap_label", "label": "Chapter label", "default": "Meet the people" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A family business," },
    { "type": "text", "id": "heading_emphasis", "label": "Heading gold ending (new line)", "default": "named after a horse." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Every Parkmore formula was worked out by people who feed, ride, foal and nurse animals themselves. No marketing department, no guesswork, just more than 50 years of horsemanship." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Gold button label", "default": "Read how Parkmore came to be" },
    { "type": "url", "id": "button_1_link", "label": "Gold button link" },
    { "type": "text", "id": "button_2_label", "label": "Outline button label", "default": "Meet the mad scientist" },
    { "type": "url", "id": "button_2_link", "label": "Outline button link" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Timeline card",
      "settings": [
        { "type": "text", "id": "year", "label": "Year pill", "default": "2002" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "article", "id": "article", "label": "Or use a blog post’s image", "info": "Used when no image is chosen above." },
        { "type": "text", "id": "image_alt", "label": "Image description" },
        { "type": "text", "id": "image_position", "label": "Image focal point (CSS)", "default": "object-position:50% 50%" },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM story timeline",
      "blocks": [
        { "type": "card", "settings": { "year": "50+ yrs", "title": "Fleur Bryan", "image_alt": "Fleur Bryan riding at Waredaca", "text": "A lifetime of breeding, foaling, starting, training and competing horses, and coaching the riders on them." } },
        { "type": "card", "settings": { "year": "2002", "title": "Parkmore Pride arrives", "image_alt": "Parkmore Pride with his rider holding the Irish flag", "text": "Fleur brings her Irish Draught stallion from Ireland to America. The company carries his name." } },
        { "type": "card", "settings": { "year": "20+ yrs", "title": "Gordon “Beaker” Bryan", "image_alt": "Gordon Bryan, the formulator behind Parkmore", "text": "Fleur’s brother and the formulator. SVMS started as a supplement for his own horses in Ireland." } },
        { "type": "card", "settings": { "year": "Today", "title": "Horses and dogs", "image_alt": "A Canine Support Teams service dog in training", "text": "Formulas for the horses and dogs in your life, recommended the same way Fleur always has: one owner at a time." } }
      ]
    }
  ]
}
{% endschema %}
