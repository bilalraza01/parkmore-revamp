{%- comment -%}
  Parkmore product row (Mockup 3, section #horses). Chapter heading, "All products" button,
  hand-picked product cards and an optional strip underneath (the Magnetic Crown prompt).
{%- endcomment -%}
{%- assign ss = section.settings -%}

<section class="pm pm-section pm-products" id="{{ ss.anchor_id | default: 'horses' | handleize }}" aria-label="{{ ss.aria_label | escape }}">
  <div class="pm-wrap">
    <div class="pm-shop-head">
      <div data-pm-reveal>
        {%- render 'pm-heading', chap_num: ss.chap_num, chap_label: ss.chap_label, line: ss.heading, em: ss.heading_emphasis, em_break: false -%}
      </div>
      {%- if ss.button_label != blank -%}
        <a class="pm-btn pm-btn-line" data-pm-reveal="2" href="{{ ss.button_link | default: '/collections/all' }}">{{ ss.button_label | escape }} <span class="pm-ar" aria-hidden="true">&rarr;</span></a>
      {%- endif -%}
    </div>

    <div class="pm-grid{{ ss.columns }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          {%- assign reveal = forloop.index | modulo: 4 -%}
          {%- if reveal == 0 -%}{%- assign reveal = 4 -%}{%- endif -%}
          {%- render 'pm-product-card',
            product: block.settings.product,
            name: block.settings.name,
            use: block.settings.use,
            badge: block.settings.badge,
            show_origin: ss.show_origin,
            origin: block.settings.origin,
            reveal: reveal,
            attrs: block.shopify_attributes
          -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if ss.strip_text != blank -%}
      <div class="pm-strip" data-pm-reveal>
        <p>{%- if ss.strip_bold != blank -%}<b>{{ ss.strip_bold | escape }}</b> {% endif -%}{{ ss.strip_text | escape }}</p>
        {%- if ss.strip_button != blank -%}
          <a class="pm-btn pm-btn-dark" href="{{ ss.strip_link | default: '/collections/all' }}">{{ ss.strip_button | escape }} <span class="pm-ar" aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  .pm-strip{margin-top:22px;display:flex;align-items:center;justify-content:space-between;gap:20px;background:var(--sand);border-radius:22px;padding:18px 26px;flex-wrap:wrap}
  .pm-strip p{font-size:16px}
  .pm-strip b{font-family:var(--serif);font-weight:500;font-size:19px}
{% endstyle %}

{% schema %}
{
  "name": "PM product row",
  "tag": "div",
  "class": "pm-section-products",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "horses" },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "For horses" },
    { "type": "text", "id": "chap_num", "label": "Chapter number", "default": "03" },
    { "type": "text", "id": "chap_label", "label": "Chapter label", "default": "For horses" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The formulas owners" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading gold ending", "default": "reorder." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "All 12 horse products" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "4", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "checkbox", "id": "show_origin", "label": "Show origin line on cards", "default": true, "info": "Made in America, or Packaged in Kentucky for GLF Immune Support." },
    { "type": "header", "content": "Strip under the cards" },
    { "type": "text", "id": "strip_bold", "label": "Bold opener", "default": "Tense before work?" },
    { "type": "text", "id": "strip_text", "label": "Text", "default": "The Parkmore Magnetic Crown fits your bridle, in 13 colors." },
    { "type": "text", "id": "strip_button", "label": "Button label", "default": "Choose a color" },
    { "type": "url", "id": "strip_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "name", "label": "Display name", "info": "Leave blank to use the product title." },
        { "type": "text", "id": "use", "label": "Use line", "info": "e.g. Daily foundation" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "e.g. Bestseller or New" },
        { "type": "text", "id": "origin", "label": "Origin line override", "info": "Leave blank for the automatic line." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM product row",
      "blocks": [ { "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" } ]
    }
  ]
}
{% endschema %}
