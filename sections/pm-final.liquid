{%- comment -%}
  Parkmore final card (Mockup 3, section #start). Photo left, text right, text-us and finder buttons,
  and an email sign-up. The sign-up uses Shopify's customer newsletter form (email marketing consent);
  Klaviyo's Shopify integration syncs those subscribers to a list.
{%- endcomment -%}
{%- assign ss = section.settings -%}

<section class="pm pm-final" id="{{ ss.anchor_id | default: 'start' | handleize }}" aria-label="{{ ss.aria_label | escape }}">
  <div class="pm-wrap">
    <div class="pm-final__card pm-dark" data-pm-reveal>
      <div class="pm-final__ph">
        {%- if ss.photo != blank -%}
          {{ ss.photo | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 901px) 640px, 100vw', loading: 'lazy', alt: ss.photo_alt, style: ss.photo_position }}
        {%- else -%}
          <div class="pm-img-fallback">[{{ ss.photo_alt | default: 'Photo' | escape }}: choose an image]</div>
        {%- endif -%}
      </div>
      <div class="pm-final__tx">
        {%- render 'pm-heading', chap_num: ss.chap_num, chap_label: ss.chap_label, line: ss.heading, em: ss.heading_emphasis, em_break: false -%}
        {%- if ss.text != blank -%}<p class="pm-final__p">{{ ss.text | escape }}</p>{%- endif -%}
        <div class="pm-final__btns">
          {%- if ss.button_1_label != blank -%}<a class="pm-btn pm-btn-gold" href="{{ ss.button_1_link }}">{{ ss.button_1_label | escape }}</a>{%- endif -%}
          {%- if ss.button_2_label != blank -%}<a class="pm-btn pm-btn-line" href="{{ ss.button_2_link }}">{{ ss.button_2_label | escape }}</a>{%- endif -%}
        </div>
        {%- if ss.signup_label != blank -%}
          {%- form 'customer', id: 'PmNewsletter', class: 'pm-nl' -%}
            <input type="hidden" name="contact[tags]" value="newsletter, homepage-feeding-notes">
            <label for="PmNewsletterEmail">{{ ss.signup_label | escape }}</label>
            <div class="pm-nl__f">
              <input id="PmNewsletterEmail" type="email" name="contact[email]" placeholder="{{ ss.signup_placeholder | escape }}" autocomplete="email" required aria-describedby="PmNewsletterMsg">
              <button class="pm-btn pm-btn-gold" type="submit">{{ ss.signup_button | escape }}</button>
            </div>
            <p class="pm-nl__msg{% if form.posted_successfully? %} ok{% elsif form.errors %} err{% endif %}" id="PmNewsletterMsg" aria-live="polite">
              {%- if form.posted_successfully? -%}
                {{ ss.signup_success | escape }}
              {%- elsif form.errors -%}
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              {%- endif -%}
            </p>
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  .pm-final{padding:0 0 110px;background:var(--ivory)}
  .pm-final__card{position:relative;overflow:hidden;border-radius:32px;background:var(--charcoal);color:var(--ivory);display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);min-height:420px}
  .pm-final__ph{position:relative;min-height:260px}
  .pm-final__ph img,.pm-final__ph .pm-img-fallback{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .pm-final__ph .pm-img-fallback{background:var(--charcoal-2);color:var(--gold-hi)}
  .pm-final__ph::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 40%,var(--charcoal));pointer-events:none}
  .pm-final__tx{padding:56px 52px;display:flex;flex-direction:column;justify-content:center}
  .pm-final__tx h2{color:var(--ivory)}
  .pm-final__p{color:#CFCBC2;margin:14px 0 24px;font-size:17px}
  .pm-final__btns{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px}
  .pm-nl{border-top:1px solid #474a4a;padding-top:22px}
  .pm-nl label{display:block;font-weight:700;margin-bottom:10px}
  .pm-nl__f{display:flex;gap:8px;background:var(--charcoal-2);border:1px solid #4d5050;border-radius:999px;padding:6px}
  .pm .pm-nl input{flex:1;min-width:0;background:transparent;border:0;padding:8px 14px;color:var(--ivory);outline:none;font:inherit;box-shadow:none}
  .pm-nl input::placeholder{color:#8f8b82}
  .pm-nl .pm-btn{padding:10px 18px;font-size:14px}
  .pm-nl__msg{font-size:13.5px;margin-top:8px;min-height:20px}
  .pm-nl__msg.ok{color:#9BC08F}
  .pm-nl__msg.err{color:#F09A94}
  @media (max-width:900px){
    .pm-final{padding-bottom:80px}
    .pm-final__card{grid-template-columns:minmax(0,1fr)}
    .pm-final__ph::after{background:linear-gradient(180deg,transparent 40%,var(--charcoal))}
    .pm-final__tx{padding:30px 26px 36px}
  }
{% endstyle %}

{% schema %}
{
  "name": "PM final card",
  "tag": "div",
  "class": "pm-section-final",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "start" },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Get started" },
    { "type": "image_picker", "id": "photo", "label": "Photo" },
    { "type": "text", "id": "photo_alt", "label": "Photo description", "default": "Fleur Bryan jumping Parkmore Pride" },
    { "type": "text", "id": "photo_position", "label": "Photo focal point (CSS)", "default": "object-position:40% 50%" },
    { "type": "text", "id": "chap_num", "label": "Chapter number", "default": "09" },
    { "type": "text", "id": "chap_label", "label": "Chapter label", "default": "Your next step" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still not sure?" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading gold ending", "default": "Just ask." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Text Fleur’s team about your horse or dog. Real horse people answer, and they’ll tell you if Parkmore isn’t the right fit." },
    { "type": "text", "id": "button_1_label", "label": "Gold button label", "default": "Text +1 (502) 265-8345" },
    { "type": "text", "id": "button_1_link", "label": "Gold button link", "default": "sms:+15022658345" },
    { "type": "text", "id": "button_2_label", "label": "Outline button label", "default": "Use the finder" },
    { "type": "text", "id": "button_2_link", "label": "Outline button link", "default": "#finder" },
    { "type": "header", "content": "Email sign-up" },
    { "type": "text", "id": "signup_label", "label": "Label", "default": "Feeding notes from Fleur, once a month" },
    { "type": "text", "id": "signup_placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text", "id": "signup_button", "label": "Button", "default": "Sign up" },
    { "type": "text", "id": "signup_success", "label": "Success message", "default": "Thanks. Your first feeding notes are on the way." }
  ],
  "presets": [ { "name": "PM final card" } ]
}
{% endschema %}
