{%- comment -%}
  "Stories from the barn." under a blog post: the three newest other posts, in the blog index card style
  (pm-blog-card), with the homepage journal heading and an "All posts" button. Internal links to the
  rest of the Journal.
{%- endcomment -%}
{{ 'pm-blog.css' | asset_url | stylesheet_tag }}
{{ 'pm-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign ss = section.settings
  assign categories = section.blocks | where: 'type', 'category'
  assign others = 0
  for a in blog.articles limit: 4
    if a.id != article.id
      assign others = others | plus: 1
    endif
  endfor
-%}
{%- if others > 0 -%}
  <section class="pm pm-section pm-artmore" aria-label="{{ ss.chap_label | escape }}">
    <div class="pm-wrap">
      <div class="pm-shop-head">
        <div data-pm-reveal>{%- render 'pm-heading', chap_num: '', chap_label: ss.chap_label, line: ss.heading, em: ss.heading_emphasis, em_break: false -%}</div>
        {%- if ss.button_label != blank -%}
          <a class="pm-btn pm-btn-line" data-pm-reveal="2" href="{{ blog.url }}">{{ ss.button_label | escape }} <span class="pm-ar" aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
      </div>
      <div class="pm-blog__grid">
        {%- assign shown = 0 -%}
        {%- for a in blog.articles limit: 4 -%}
          {%- if a.id != article.id and shown < 3 -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- render 'pm-blog-card', article: a, categories: categories, ss: ss, feature: false, reveal: shown -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PM more posts",
  "tag": "div",
  "class": "pm-section-artmore",
  "enabled_on": { "templates": ["article"] },
  "settings": [
    { "type": "text", "id": "chap_label", "label": "Label", "default": "The Parkmore Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories from" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading gold ending", "default": "the barn." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "All posts" },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "range", "id": "excerpt_words", "label": "Excerpt length (words)", "min": 0, "max": 60, "step": 5, "default": 20 },
    { "type": "text", "id": "read_more", "label": "Read more label", "default": "Read the story" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "Shown as a pill on the photo, e.g. Customer Stories" },
        { "type": "text", "id": "tag", "label": "Article tag", "info": "The tag used on the posts, e.g. customer-stories" }
      ]
    }
  ],
  "presets": [ { "name": "PM more posts" } ]
}
{% endschema %}
