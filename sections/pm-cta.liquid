{%- comment -%}
  Parkmore call-to-action band: a dark rounded card with a Lora heading (gold second line) and a gold
  button. Replaces Ignite's ribbon banner ("Still got questions? Don't be a stranger.") on the FAQ pages.
{%- endcomment -%}
{{ 'pm-pages.css' | asset_url | stylesheet_tag }}
{%- assign ss = section.settings -%}
<section class="pm pm-cta" aria-label="{{ ss.heading | append: ' ' | append: ss.heading_emphasis | strip | escape }}">
  <div class="pm-wrap">
    <div class="pm-cta__card pm-dark" data-pm-reveal>
      <h2>
        {{- ss.heading | escape -}}
        {%- if ss.heading_emphasis != blank -%}{%- if ss.heading != blank -%}<br>{%- endif -%}<em>{{ ss.heading_emphasis | escape }}</em>{%- endif -%}
      </h2>
      {%- if ss.button_label != blank -%}
        <a class="pm-btn pm-btn-gold" href="{{ ss.button_link | default: '#' }}">{{ ss.button_label | escape }} <span class="pm-ar" aria-hidden="true">&rarr;</span></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PM call to action",
  "tag": "div",
  "class": "pm-section-cta",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still got questions?" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading gold line", "default": "Don’t be a stranger." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get in touch" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "PM call to action" } ]
}
{% endschema %}
