{%- comment -%}
  Parkmore FAQ: search box and group links on the left, questions grouped under headings on the right.
  Replaces Ignite's "Collapsible rows" section with the same content (title, text, group headings,
  questions, answers, buttons and closing text). Rows are <details>, so answers work without JavaScript
  and stay in the page for search engines. pm-pages.js adds the search filter and one-row-at-a-time.
  Group and card wrappers open and close across loop iterations (always balanced by the end of the loop).
{%- endcomment -%}
{%- comment -%}theme-check-disable UnclosedHTMLElement{%- endcomment -%}
{{ 'pm-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pm-pages.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign ss = section.settings
  assign groups = section.blocks | where: 'type', 'group'
  assign in_group = false
  assign in_card = false
  assign search_label = 'sections.collapsible_rows.search' | t
-%}

<section class="pm pm-faq" aria-label="{{ ss.title | default: search_label | escape }}">
  <div class="pm-wrap pm-faq__grid">
    <aside class="pm-faq__aside">
      <div class="pm-faq__sticky" data-pm-reveal>
        {%- if ss.title != blank -%}
          {%- if ss.title_tag == 'h2' -%}
            <h2 class="pm-faq__title">{{ ss.title | escape }}</h2>
          {%- else -%}
            <p class="pm-faq__title">{{ ss.title | escape }}</p>
          {%- endif -%}
        {%- endif -%}
        {%- if ss.text != blank -%}<div class="pm-faq__text pm-rte">{{ ss.text }}</div>{%- endif -%}
        {%- if ss.show_search -%}
          <div class="pm-faq__search">
            <label class="pm-sr-only" for="PmFaqSearch-{{ section.id }}">{{ search_label | escape }}</label>
            <input type="search" id="PmFaqSearch-{{ section.id }}" placeholder="{{ search_label | escape }}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-pm-faq-search>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
          </div>
        {%- endif -%}
        {%- if groups.size > 1 -%}
          <nav class="pm-faq__toc" aria-label="{{ ss.title | default: search_label | escape }}">
            {%- for g in groups -%}
              <a href="#PmFaq-{{ section.id }}-{{ g.id }}">{{ g.settings.heading | escape }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>
    </aside>

    <div class="pm-faq__main" data-pm-faq{% if ss.one_at_a_time %} data-pm-faq-one{% endif %}>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'group' -%}
            {%- if in_card -%}</div>{%- assign in_card = false -%}{%- endif -%}
            {%- if in_group -%}</div>{%- endif -%}
            <div class="pm-faq__group" id="PmFaq-{{ section.id }}-{{ block.id }}" data-pm-faq-group {{ block.shopify_attributes }}>
              <h2 class="pm-faq__gh" data-pm-faq-hide>{{ block.settings.heading | escape }}</h2>
              <div class="pm-faq__card" data-pm-reveal>
            {%- assign in_group = true -%}
            {%- assign in_card = true -%}

          {%- when 'row' -%}
            {%- if block.settings.question != blank -%}
              {%- unless in_card -%}<div class="pm-faq__card" data-pm-reveal>{%- assign in_card = true -%}{%- endunless -%}
              <details class="pm-faq__row" data-pm-faq-row{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                <summary><h3>{{ block.settings.question | escape }}</h3><i aria-hidden="true"></i></summary>
                <div class="pm-faq__a">
                  {%- if block.settings.answer != blank -%}<div class="pm-rte">{{ block.settings.answer }}</div>{%- endif -%}
                  {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                    <div class="pm-faq__btns">
                      {%- if block.settings.button_label_1 != blank -%}<a class="pm-btn pm-btn-dark pm-btn-sm" href="{{ block.settings.button_link_1 | default: '#' }}">{{ block.settings.button_label_1 | escape }} <span class="pm-ar" aria-hidden="true">&rarr;</span></a>{%- endif -%}
                      {%- if block.settings.button_label_2 != blank -%}<a class="pm-btn pm-btn-line pm-btn-sm" href="{{ block.settings.button_link_2 | default: '#' }}">{{ block.settings.button_label_2 | escape }}</a>{%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if in_card -%}</div>{%- assign in_card = false -%}{%- endif -%}
            {%- if in_group -%}</div>{%- assign in_group = false -%}{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="pm-faq__note pm-rte" data-pm-faq-hide {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
      {%- if in_card -%}</div>{%- endif -%}
      {%- if in_group -%}</div>{%- endif -%}
      <p class="pm-faq__empty" data-pm-faq-empty hidden>{{ 'sections.collapsible_rows.no_results' | t }}</p>
    </div>
  </div>
</section>

{%- if ss.render_schema -%}
  {%- capture faqs -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'row' and block.settings.question != blank and block.settings.answer != blank -%}
        { "@type": "Question", "name": {{ block.settings.question | strip_html | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} } },
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if faqs != blank -%}
    <script type="application/ld+json">
      { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [ {{ faqs | strip | remove_last: ',' }} ] }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "PM FAQ",
  "tag": "div",
  "class": "pm-section-faq",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Search" },
    { "type": "select", "id": "title_tag", "label": "Title style", "default": "h2", "options": [
      { "value": "h2", "label": "Heading" },
      { "value": "p", "label": "Label (when the title is just \"Search\")" }
    ] },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_search", "label": "Show search box", "default": true },
    { "type": "checkbox", "id": "one_at_a_time", "label": "Open one question at a time", "default": true },
    { "type": "checkbox", "id": "render_schema", "label": "Add FAQ structured data for search engines", "default": false }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Orders" } ]
    },
    {
      "type": "row",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false },
        { "type": "text", "id": "button_label_1", "label": "Button label" },
        { "type": "url", "id": "button_link_1", "label": "Button link" },
        { "type": "text", "id": "button_label_2", "label": "Second button label" },
        { "type": "url", "id": "button_link_2", "label": "Second button link" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [ { "type": "richtext", "id": "text", "label": "Text" } ]
    }
  ],
  "presets": [ { "name": "PM FAQ", "blocks": [ { "type": "group" }, { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
