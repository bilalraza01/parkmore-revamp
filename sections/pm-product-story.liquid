{%- comment -%}
  Parkmore product story (product page mockup option A): the product description as an article,
  collapsed behind "See more" when long. Only shown for long descriptions; short ones sit under the title
  in pm-product-main (same word threshold setting there).
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign words = product.description | strip_html | split: ' ' | size
  assign quote = ''
  if product.description contains '<blockquote'
    assign quote = product.description | split: '<blockquote' | last | split: '</blockquote>' | first | strip_html | strip | remove_first: '>' | strip
  endif
-%}
{%- if words >= ss.min_words and product.description != blank -%}
  <section class="pm pm-psec pm-section pmp-story" id="story" aria-label="{{ ss.chap_label | escape }}">
    <div class="pm-wrap pmp-story__grid">
      <aside class="pmp-story__aside">
        {%- render 'pm-heading', chap_num: ss.chap_num, chap_label: ss.chap_label, line: ss.heading, em: ss.heading_emphasis, em_break: false -%}
        {%- if quote != blank -%}<blockquote>“{{ quote | remove: '“' | remove: '”' | remove: '"' }}”</blockquote>{%- endif -%}
      </aside>
      <div class="pmp-story__wrap" data-pm-story>
        <div class="pmp-story__clip rte" data-pm-story-clip>{{ product.description }}</div>
        <button class="pmp-story__more" type="button" aria-expanded="false" data-pm-story-more hidden><span>{{ ss.more_label | escape }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg></button>
      </div>
    </div>
  </section>
  <script type="application/json" data-pm-story-labels>{"more": {{ ss.more_label | json }}, "less": {{ ss.less_label | json }}}</script>
{%- endif -%}

{% schema %}
{
  "name": "PM product story",
  "tag": "div",
  "class": "pm-section-pstory",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "chap_num", "label": "Chapter number", "default": "02" },
    { "type": "text", "id": "chap_label", "label": "Chapter label", "default": "The full story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why we" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading gold ending", "default": "make it." },
    { "type": "range", "id": "min_words", "label": "Show for descriptions from (words)", "min": 50, "max": 300, "step": 10, "default": 120, "info": "Keep equal to the PM product section's long description setting." },
    { "type": "text", "id": "more_label", "label": "See more label", "default": "See more" },
    { "type": "text", "id": "less_label", "label": "See less label", "default": "See less" }
  ],
  "presets": [ { "name": "PM product story" } ]
}
{% endschema %}
